{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "server-telemetry",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TELEMETRY=1",
        "CONTACT_EMAIL=bugs@example.invalid",
        "DATA_CONTROLLER=Local preview",
        "npm", "--prefix", "server", "start"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
